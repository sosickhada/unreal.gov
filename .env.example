# Copy/merge outside Git. No shell expansion. Shell/systemd compatible KEY=value.
UNREAL_DB=/opt/unreal-github/unreal_bot.db
ENABLE_EXTERNAL_CALLS=0
AUTOMATION_PAUSED=0
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
PUBLIC_BASE_URL=https://unreal-korea-media.duckdns.org
IMAGE_DIR=/opt/unreal.gov/public/images
RENDER_DIR=/opt/unreal-github/data/rendered
# Separate operational approval is required for public image exposure.
ENABLE_PUBLIC_MEDIA=0
REQUIRE_TOPIC_IMAGE=1
# Search missing subjects for manual review; never auto-approve provider photos.
AUTO_IMAGE_SEARCH=0
# Automatic preview photos: provider license evidence + machine screening; final human approval required.
AUTO_PHOTO_ACQUIRE=0
UNREAL_BROWSER_PROFILE_DIR=/tmp
RENDER_TIMEOUT_SECONDS=180
FONT_TIMEOUT_SECONDS=45
PIXABAY_API_KEY=
# Daily candidates work without RSS or a candidate-generation API call.
CANDIDATE_GENERATION_MODE=curated
USE_NEWS_REFERENCE=0
NEWS_MAX_AGE_HOURS=72
MAX_CLAUDE_CALLS_PER_DAY=12
MAX_RESERVED_TOKENS_PER_DAY=360000
TOKENS_RESERVED_PER_CALL=30000
MAX_CANDIDATE_REGENERATIONS=2
MAX_CONTENT_REVISIONS=3
INSTAGRAM_PUBLISH_ENABLED=0
# Facebook Login / Page-linked professional Instagram account only
# Instagram Login only (no Facebook Page or META_* tokens)
IG_GRAPH_VERSION=v25.0
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
# Verified expiry from token issuance/refresh response (Unix seconds)
IG_TOKEN_EXPIRES_AT=
