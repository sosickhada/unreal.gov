[Unit]
Description=Unreal Bureau Telegram approval listener
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
Type=simple
User=dbsdudtn7612
WorkingDirectory=/opt/unreal-github
EnvironmentFile=/opt/unreal.gov/.env
ExecStart=/opt/unreal-github/.venv/bin/python /opt/unreal-github/telegram_listener.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/unreal-github

[Install]
WantedBy=multi-user.target
